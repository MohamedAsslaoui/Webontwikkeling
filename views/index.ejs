<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <title>Movies</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include("partials/navbar") %>

    <main>
        <h1>Movies</h1>

        <form method="GET" action="/">
            <input type="text" name="search" value="<%= search %>" placeholder="Search by title">
            <button type="submit">Search</button>
        </form>

        <table>
            <thead>
                <tr>
                    <th>
                        <a href="/?search=<%= search %>&sortField=title&sortDirection=<%= sortDirection === 'asc' ? 'desc' : 'asc' %>">
                            Title
                            <% if (sortField === "title") { %>
                                <%= sortDirection === "asc" ? "▲" : "▼" %>
                            <% } %>
                        </a>
                    </th>

                    <th>
                        <a href="/?search=<%= search %>&sortField=releaseYear&sortDirection=<%= sortDirection === 'asc' ? 'desc' : 'asc' %>">
                            Release year
                            <% if (sortField === "releaseYear") { %>
                                <%= sortDirection === "asc" ? "▲" : "▼" %>
                            <% } %>
                        </a>
                    </th>

                    <th>
                        <a href="/?search=<%= search %>&sortField=genre&sortDirection=<%= sortDirection === 'asc' ? 'desc' : 'asc' %>">
                            Genre
                            <% if (sortField === "genre") { %>
                                <%= sortDirection === "asc" ? "▲" : "▼" %>
                            <% } %>
                        </a>
                    </th>

                    <th>
                        <a href="/?search=<%= search %>&sortField=isAvailable&sortDirection=<%= sortDirection === 'asc' ? 'desc' : 'asc' %>">
                            Available
                            <% if (sortField === "isAvailable") { %>
                                <%= sortDirection === "asc" ? "▲" : "▼" %>
                            <% } %>
                        </a>
                    </th>

                    <th>
                        <a href="/?search=<%= search %>&sortField=studio&sortDirection=<%= sortDirection === 'asc' ? 'desc' : 'asc' %>">
                            Studio
                            <% if (sortField === "studio") { %>
                                <%= sortDirection === "asc" ? "▲" : "▼" %>
                            <% } %>
                        </a>
                    </th>

                    <th>Detail</th>
                    <% if (role === "ADMIN") { %>
                        <th>Edit</th>
                    <% } %>
                </tr>
            </thead>

            <tbody>
                <% movies.forEach((movie) => { %>
                    <tr>
                        <td><%= movie.title %></td>
                        <td><%= movie.releaseDate.split("-")[0] %></td>
                        <td><%= movie.genre %></td>
                        <td><%= movie.isAvailable ? "Yes" : "No" %></td>
                        <td><%= movie.studio.name %></td>
                        <td><a href="/movies/<%= movie.id %>">View</a></td>
                        <% if (role === "ADMIN") { %>
                            <td>
                                <a href="/movies/<%= movie.id %>/edit">Edit</a>
                            </td>
                        <% } %>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </main>
</body>
</html>